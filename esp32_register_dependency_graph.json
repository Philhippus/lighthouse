    },
    {
      "from": "GPIO_MATRIX_SEL",
      "to": "I2C_COMD",
      "note": "I2C SDA/SCL must be routed through GPIO Matrix"
    },
    {
      "from": "GPIO_ENABLE",
      "to": "GPIO_OUT",
      "note": "pin must be marked output before OUT write has effect"
    },
    {
      "from": "GPIO_PINn",
      "to": "GPIO_STATUS",
      "note": "INT_TYPE/INT_ENA must be set before status bits are meaningful"
    },
    {
      "from": "GPIO_PAD_DRIVER",
      "to": "I2C_COMD",
      "note": "I2C pins should be configured open-drain before bus use"
    },
    {
      "from": "GPIO_PINn",
      "to": "RTCIO_PINn",
      "note": "digital GPIO config coexists with / is superseded by RTCIO config for RTC-capable pins"
    },
    {
      "from": "UART_CLKDIV",
      "to": "UART_TXRX",
      "note": "baud rate divisor must be set before data is sent/received correctly"
    },
    {
      "from": "UART_CONF0",
      "to": "UART_TXRX",
      "note": "frame format (data/parity/stop bits) must be set first"
    },
    {
      "from": "SPI_CLOCK",
      "to": "SPI_CMD",
      "note": "clock divider must be set before SPI_CMD.USR starts a transaction"
    },
    {
      "from": "I2C_SCL_PERIOD",
      "to": "I2C_COMD",
      "note": "bus timing must be set before issuing command sequence"
    },
    {
      "from": "TIMG_CONFIG",
      "to": "TIMG_COUNTER",
      "note": "enable+prescaler must be set before the 64-bit counter runs"
    },
    {
      "from": "TIMG_WDTWPROTECT",
      "to": "TIMG_WDTCONFIG",
      "note": "must write unlock key 0x50D83AA1 before WDT config/feed registers accept writes"
